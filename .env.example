# Qazaq CLI — параметрлерді env арқылы беруге болады (міндетті емес, config файл да бар)

# Әдепкі провайдер: openai | openrouter | groq | deepseek | together | mistral | xai | gemini | ollama | custom
QAZAQ_PROVIDER=openai

# Әдепкі модель (бос болса — провайдердің defaultModel қолданылады)
QAZAQ_MODEL=

# Провайдер кілттері (қайсысын қолдансаңыз, соны толтырыңыз)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Custom / өзіндік OpenAI-үйлесімді endpoint үшін:
# QAZAQ_BASE_URL=https://your-endpoint/v1
# QAZAQ_API_KEY=your-key
